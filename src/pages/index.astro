---
import BaseLayout from '../layouts/BaseLayout.astro';
import StoreBadges from '../components/StoreBadges.astro';
import FAQSection from '../components/FAQSection.astro';
import AppShowcase from '../components/AppShowcase.astro';

const websiteSchema = {
  '@context': 'https://schema.org',
  '@type': 'WebSite',
  name: 'Screening Clearing',
  url: 'https://screeningclearing.com',
  description: 'Track your personal health screening schedule. Free iOS and Android app.',
};

const appSchema = {
  '@context': 'https://schema.org',
  '@type': 'SoftwareApplication',
  name: 'Screening Clearing',
  applicationCategory: 'HealthApplication',
  operatingSystem: 'iOS, Android',
  offers: { '@type': 'Offer', price: '0', priceCurrency: 'EUR' },
  description: 'Screening Clearing is a free iOS and Android app that helps adults track their personal health screening schedule, set reminders for check-ups, and keep their health history private on their device.',
  url: 'https://screeningclearing.com',
};

const orgSchema = {
  '@context': 'https://schema.org',
  '@type': 'Organization',
  name: 'Screening Clearing',
  url: 'https://screeningclearing.com',
  description: 'Free iOS and Android app for tracking personal health screening schedules.',
  contactPoint: { '@type': 'ContactPoint', contactType: 'customer support', url: 'https://screeningclearing.com/support' },
};

const homeFaqs = [
  {
    q: 'What is Screening Clearing?',
    a: "The name says it: you take your list of check-ups — the ones due for your age, the ones your doctor recommended, any exam or test you need to stay on top of — and, one by one, you clear them. Screening Clearing is a free app for iOS and Android that tracks your personal health check-up schedule. It tells you which check-ups are due, lets you log when you had them, and sends reminders so nothing slips through the cracks.",
  },
  {
    q: 'Is Screening Clearing free to use?',
    a: 'Yes, Screening Clearing is free to download and use. A premium upgrade is available for additional features like unlimited custom exams and document storage.',
  },
  {
    q: 'Does the app store my health data on a server?',
    a: 'No. All your health data stays on your device. Screening Clearing does not send your personal information to any server. Your health history is private and only accessible to you.',
  },
  {
    q: 'Is Screening Clearing a medical app?',
    a: 'No. Screening Clearing is a personal organiser for health check-ups. It helps you track and remember screenings based on general guidelines, but it does not provide medical advice or diagnoses. Always consult your doctor for personal medical decisions.',
  },
  {
    q: 'Which screenings does the app track?',
    a: 'The app covers a wide range of common preventive screenings including blood tests, blood pressure checks, eye exams, dental check-ups, cancer screenings, and more — filtered by your age and profile.',
  },
  {
    q: 'Can I use the app for the whole family?',
    a: 'The app is currently designed for one personal profile per device. You can use separate devices for different family members. Multi-profile support is on the roadmap.',
  },
];

const benefits = [
  {
    icon: '🗓️',
    title: 'See exactly what\'s overdue',
    desc: "Your full screening schedule in one place. Reminders before things slip, not after.",
  },
  {
    icon: '🔒',
    title: 'No account. No cloud. Just your phone.',
    desc: 'Your health history never leaves your device. No sign-up, no server, no tracking.',
  },
  {
    icon: '✅',
    title: 'Clear them as you go',
    desc: "Mark each check-up done and watch your list shrink. Build a health history you actually own — no clinic portal, no paperwork.",
  },
];
---

<BaseLayout
  title="Screening Clearing"
  description="Never miss a health check-up again. Screening Clearing is a free iOS and Android app that tracks your personal prevention schedule and reminds you when screenings are due."
  jsonLd={[websiteSchema, appSchema, orgSchema]}
  preloadHeroImage={true}
>
  <!-- Hero -->
  <section class="relative overflow-hidden px-4 pt-16 pb-20 md:pt-24 md:pb-28">
    <div class="max-w-6xl mx-auto grid md:grid-cols-2 gap-12 items-center">
      <div>
        <div class="inline-flex items-center gap-2 bg-[#0891b2]/10 border border-[#0891b2]/30 text-[#06b6d4] text-xs font-semibold px-3 py-1.5 rounded-full mb-6">
          Free to download · iOS &amp; Android · No account needed
        </div>
        <h1 class="text-4xl md:text-5xl lg:text-6xl font-black text-[#f1f5f9] leading-tight mb-6">
          Most adults are behind<br />
          on at least one<br />
          <span class="text-[#0891b2]">screening.</span>
        </h1>
        <p class="text-[#94a3b8] text-lg leading-relaxed mb-8 max-w-md">
          Think of it as your health to-do list — the check-ups, tests, and exams that are due at your age or that your doctor has recommended, one by one, cleared. Screening Clearing shows you what's overdue, what's coming up, and what you've already ticked off. Privately, on your phone.
        </p>
        <div class="flex flex-wrap items-center gap-4 mb-6">
          <a href="/am-i-due"
             class="inline-flex items-center gap-2 bg-[#0e7490] hover:bg-[#0891b2] text-white font-bold px-6 py-3 rounded-xl transition-colors text-base">
            Check if I'm due →
          </a>
          <span class="text-[#94a3b8] text-sm">or download the app</span>
        </div>
        <StoreBadges size="lg" />
        <p class="text-[#94a3b8] text-xs mt-4">Always consult your doctor for personal medical decisions.</p>
      </div>

      <div class="flex justify-center md:justify-end">
        <img
          src="/images/hero.webp"
          alt="Screening Clearing app showing health check-up schedule"
          class="w-72 md:w-80 lg:w-96 h-auto object-contain drop-shadow-2xl"
          width="409"
          height="610"
          loading="eager"
          fetchpriority="high"
          decoding="async"
        />
      </div>
    </div>
  </section>

  <!-- Benefits -->
  <section class="py-16 border-t border-[#1e293b]" aria-labelledby="benefits-heading">
    <div class="max-w-6xl mx-auto px-4">
      <h2 id="benefits-heading" class="sr-only">Why use Screening Clearing</h2>
      <div class="grid md:grid-cols-3 gap-8">
        {benefits.map((b) => (
          <div class="bg-[#0d1424] border border-[#1e293b] rounded-2xl p-6">
            <div class="text-3xl mb-4" role="img" aria-label={b.title}>{b.icon}</div>
            <h3 class="text-[#f1f5f9] font-bold text-lg mb-2">{b.title}</h3>
            <p class="text-[#94a3b8] text-sm leading-relaxed">{b.desc}</p>
          </div>
        ))}
      </div>
      <p class="text-[#94a3b8] text-sm mt-8 text-center">
        Not sure which screenings apply to you? <a href="/blog/health-screening-guide-adults" class="text-[#06b6d4] underline hover:no-underline">Our adult screening guide</a> breaks it down by decade.
      </p>
    </div>
  </section>

  <!-- App Showcase -->
  <AppShowcase />

  <!-- How it works -->
  <section class="py-16" aria-labelledby="how-it-works-heading">
    <div class="max-w-3xl mx-auto px-4 text-center">
      <h2 id="how-it-works-heading" class="text-3xl font-black text-[#f1f5f9] mb-12">How it works</h2>
      <div class="grid md:grid-cols-3 gap-8">
        {[
          { step: '1', title: 'Set up your profile', desc: 'Enter your age and basic details. The app builds a personalised screening schedule — nothing generic, nothing irrelevant.' },
          { step: '2', title: "See what's due", desc: "Most people are surprised. The overdue pile is bigger than they thought. Now you can see the full picture at once." },
          { step: '3', title: 'Log and track', desc: "Mark them done. Clear them off. Build a health history you actually own — on your phone, privately, forever." },
        ].map((s) => (
          <div class="flex flex-col items-center text-center">
            <div class="w-12 h-12 rounded-full bg-[#0e7490] text-white font-black text-xl flex items-center justify-center mb-4">{s.step}</div>
            <h3 class="text-[#f1f5f9] font-bold mb-2">{s.title}</h3>
            <p class="text-[#94a3b8] text-sm leading-relaxed">{s.desc}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- FAQ -->
  <FAQSection items={homeFaqs} title="Questions about Screening Clearing" />

  <!-- CTA Banner -->
  <section class="py-16 border-t border-[#1e293b]">
    <div class="max-w-2xl mx-auto px-4 text-center">
      <h2 class="text-3xl font-black text-[#f1f5f9] mb-4">Start clearing your health to-do list.</h2>
      <p class="text-[#94a3b8] mb-8">Free to download. No account. Two minutes to set up. Your check-ups, cleared.</p>
      <StoreBadges class="justify-center" size="lg" />
    </div>
  </section>
</BaseLayout>
