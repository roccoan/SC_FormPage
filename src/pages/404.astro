---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout
  title="Page Not Found"
  description="The page you were looking for doesn't exist."
  noindex={true}
>
  <div class="max-w-2xl mx-auto px-4 py-32 text-center">
    <p class="text-[#0891b2] text-6xl font-black mb-4">404</p>
    <h1 class="text-2xl font-bold text-[#f1f5f9] mb-4">Page not found</h1>
    <p class="text-[#94a3b8] mb-10">The page you were looking for doesn't exist or has been moved.</p>
    <div class="flex flex-wrap justify-center gap-4">
      <a href="/" class="bg-[#0891b2] hover:bg-[#06b6d4] text-white font-semibold px-6 py-3 rounded-xl transition-colors text-sm">
        Go to homepage
      </a>
      <a href="/support" class="border border-[#1e293b] hover:border-[#0891b2] text-[#94a3b8] hover:text-[#f1f5f9] font-semibold px-6 py-3 rounded-xl transition-colors text-sm">
        Get support
      </a>
    </div>
  </div>
</BaseLayout>
