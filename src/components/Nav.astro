---
const APP_STORE_URL = import.meta.env.PUBLIC_APP_STORE_URL ?? '#coming-soon';
const PLAY_STORE_URL = import.meta.env.PUBLIC_PLAY_STORE_URL ?? '#coming-soon';
const isComingSoon = !import.meta.env.PUBLIC_APP_STORE_URL;
const badgeBase = 'inline-flex items-center gap-1.5 text-white text-sm font-semibold px-3 py-2 rounded-lg transition-colors';
const badgeActive = 'bg-[#0e7490] hover:bg-[#0891b2]';
const badgeDisabled = 'bg-[#0891b2]/40 opacity-60 pointer-events-none cursor-not-allowed';
---

<header class="fixed top-0 left-0 right-0 z-50 border-b border-[#1e293b] bg-[#0a0f1a]/90 backdrop-blur-sm">
  <nav class="max-w-6xl mx-auto px-4 h-16 flex items-center justify-between">
    <a href="/" aria-label="Screening Clearing – home" class="flex items-center gap-2 font-bold text-[#f1f5f9] hover:text-[#06b6d4] transition-colors">
      <svg width="28" height="28" viewBox="0 0 28 28" fill="none" xmlns="http://www.w3.org/2000/svg">
        <rect width="28" height="28" rx="8" fill="#0891b2"/>
        <path d="M14 6v16M6 14h16" stroke="white" stroke-width="2.5" stroke-linecap="round"/>
      </svg>
      <span class="hidden sm:block">Screening Clearing</span>
    </a>

    <div class="hidden md:flex items-center gap-8 text-sm text-[#94a3b8]">
      <a href="/blog" class="hover:text-[#f1f5f9] transition-colors py-2">Blog</a>
      <a href="/faq" class="hover:text-[#f1f5f9] transition-colors py-2">FAQ</a>
      <a href="/support" class="hover:text-[#f1f5f9] transition-colors py-2">Support</a>
    </div>

    <div class="flex items-center gap-2">
      <a href="/am-i-due"
         class="hidden md:inline-flex items-center gap-1.5 border border-orange-500 text-orange-400 hover:bg-orange-500/10 text-sm font-semibold px-3 py-2 rounded-lg transition-colors">
        Am I Due?
      </a>
      <a
        href={isComingSoon ? undefined : APP_STORE_URL}
        aria-label="Download on the App Store"
        class={`hidden sm:inline-flex ${badgeBase} ${isComingSoon ? badgeDisabled : badgeActive}`}
        {...(isComingSoon ? { tabindex: '-1' } : {})}
      >
        <svg width="15" height="15" viewBox="0 0 24 24" fill="white"><path d="M18.71 19.5c-.83 1.24-1.71 2.45-3.05 2.47-1.34.03-1.77-.79-3.29-.79-1.53 0-2 .77-3.27.82-1.31.05-2.3-1.32-3.14-2.53C4.25 17 2.94 12.45 4.7 9.39c.87-1.52 2.43-2.48 4.12-2.51 1.28-.02 2.5.87 3.29.87.78 0 2.26-1.07 3.8-.91.65.03 2.47.26 3.64 1.98-.09.06-2.17 1.28-2.15 3.81.03 3.02 2.65 4.03 2.68 4.04-.03.07-.42 1.44-1.38 2.83M13 3.5c.73-.83 1.94-1.46 2.94-1.5.13 1.17-.34 2.35-1.04 3.19-.69.85-1.83 1.51-2.95 1.42-.15-1.15.41-2.35 1.05-3.11z"/></svg>
        iOS
      </a>
      <a
        href={isComingSoon ? undefined : PLAY_STORE_URL}
        aria-label="Get it on Google Play"
        class={`hidden sm:inline-flex ${badgeBase} ${isComingSoon ? badgeDisabled : badgeActive}`}
        {...(isComingSoon ? { tabindex: '-1' } : {})}
      >
        <svg width="15" height="15" viewBox="0 0 24 24"><path d="M3.18 23.76c.3.17.64.22.99.14l13.23-7.63-2.9-2.9-11.32 10.39z" fill="white"/><path d="M22.46 10.48L19.2 8.6l-3.24 3.24 3.24 3.24 3.29-1.9c.94-.54.94-2.16-.03-2.7z" fill="white"/><path d="M3.18.24C2.83.33 2.5.58 2.3.97L13.63 12.3l2.9-2.9L3.18.24z" fill="white"/><path d="M2.3.97C2.11 1.35 2 1.8 2 2.28v19.44c0 .48.1.93.3 1.31l.06.05 10.89-10.89v-.25L2.36.92l-.06.05z" fill="white"/></svg>
        Android
      </a>

      <!-- Mobile hamburger -->
      <button
        id="nav-hamburger"
        class="md:hidden flex flex-col justify-center items-center w-11 h-11 gap-1.5 rounded-lg hover:bg-white/10 transition-colors"
        aria-label="Open navigation menu"
        aria-expanded="false"
        aria-controls="mobile-menu"
      >
        <span class="block w-5 h-0.5 bg-[#f1f5f9] transition-all" id="hb-top"></span>
        <span class="block w-5 h-0.5 bg-[#f1f5f9] transition-all" id="hb-mid"></span>
        <span class="block w-5 h-0.5 bg-[#f1f5f9] transition-all" id="hb-bot"></span>
      </button>
    </div>
  </nav>

  <!-- Mobile menu -->
  <div
    id="mobile-menu"
    class="md:hidden hidden border-t border-[#1e293b] bg-[#0a0f1a]/95 backdrop-blur-sm px-4 py-4 flex-col gap-1"
  >
    <a href="/am-i-due" class="flex items-center gap-2 text-orange-400 font-semibold text-sm px-3 py-2.5 rounded-lg hover:bg-orange-500/10 transition-colors">
      Am I Due?
    </a>
    <a href="/blog" class="text-[#94a3b8] text-sm px-3 py-2.5 rounded-lg hover:text-[#f1f5f9] hover:bg-white/5 hover:underline transition-colors">Blog</a>
    <a href="/faq" class="text-[#94a3b8] text-sm px-3 py-2.5 rounded-lg hover:text-[#f1f5f9] hover:bg-white/5 hover:underline transition-colors">FAQ</a>
    <a href="/support" class="text-[#94a3b8] text-sm px-3 py-2.5 rounded-lg hover:text-[#f1f5f9] hover:bg-white/5 hover:underline transition-colors">Support</a>
    <div class="flex gap-2 mt-2 pt-2 border-t border-[#1e293b]">
      <a
        href={isComingSoon ? undefined : APP_STORE_URL}
        aria-label="Download on the App Store"
        class={`flex-1 flex items-center justify-center gap-1.5 ${badgeBase} ${isComingSoon ? badgeDisabled : badgeActive}`}
        {...(isComingSoon ? { tabindex: '-1' } : {})}
      >
        <svg width="14" height="14" viewBox="0 0 24 24" fill="white"><path d="M18.71 19.5c-.83 1.24-1.71 2.45-3.05 2.47-1.34.03-1.77-.79-3.29-.79-1.53 0-2 .77-3.27.82-1.31.05-2.3-1.32-3.14-2.53C4.25 17 2.94 12.45 4.7 9.39c.87-1.52 2.43-2.48 4.12-2.51 1.28-.02 2.5.87 3.29.87.78 0 2.26-1.07 3.8-.91.65.03 2.47.26 3.64 1.98-.09.06-2.17 1.28-2.15 3.81.03 3.02 2.65 4.03 2.68 4.04-.03.07-.42 1.44-1.38 2.83M13 3.5c.73-.83 1.94-1.46 2.94-1.5.13 1.17-.34 2.35-1.04 3.19-.69.85-1.83 1.51-2.95 1.42-.15-1.15.41-2.35 1.05-3.11z"/></svg>
        iOS {isComingSoon && <span class="text-[10px] opacity-70">(soon)</span>}
      </a>
      <a
        href={isComingSoon ? undefined : PLAY_STORE_URL}
        aria-label="Get it on Google Play"
        class={`flex-1 flex items-center justify-center gap-1.5 ${badgeBase} ${isComingSoon ? badgeDisabled : badgeActive}`}
        {...(isComingSoon ? { tabindex: '-1' } : {})}
      >
        <svg width="14" height="14" viewBox="0 0 24 24"><path d="M3.18 23.76c.3.17.64.22.99.14l13.23-7.63-2.9-2.9-11.32 10.39z" fill="white"/><path d="M22.46 10.48L19.2 8.6l-3.24 3.24 3.24 3.24 3.29-1.9c.94-.54.94-2.16-.03-2.7z" fill="white"/><path d="M3.18.24C2.83.33 2.5.58 2.3.97L13.63 12.3l2.9-2.9L3.18.24z" fill="white"/><path d="M2.3.97C2.11 1.35 2 1.8 2 2.28v19.44c0 .48.1.93.3 1.31l.06.05 10.89-10.89v-.25L2.36.92l-.06.05z" fill="white"/></svg>
        Android {isComingSoon && <span class="text-[10px] opacity-70">(soon)</span>}
      </a>
    </div>
  </div>
</header>

<!-- spacer for fixed nav -->
<div class="h-16"></div>

<script>
  const btn = document.getElementById('nav-hamburger')!;
  const menu = document.getElementById('mobile-menu')!;

  function open() {
    menu.classList.remove('hidden');
    menu.classList.add('flex');
    btn.setAttribute('aria-expanded', 'true');
  }
  function close() {
    menu.classList.add('hidden');
    menu.classList.remove('flex');
    btn.setAttribute('aria-expanded', 'false');
  }

  btn.addEventListener('click', () => {
    btn.getAttribute('aria-expanded') === 'true' ? close() : open();
  });

  document.addEventListener('keydown', (e) => { if (e.key === 'Escape') close(); });
  document.addEventListener('click', (e) => {
    if (!menu.contains(e.target as Node) && !btn.contains(e.target as Node)) close();
  });
</script>
