---
interface FAQItem {
  q: string;
  a: string;
}
interface Props {
  items: FAQItem[];
}
const { items } = Astro.props;
---

<section class="my-10">
  <h2 class="text-2xl font-black text-[#f1f5f9] mb-6">Frequently Asked Questions</h2>
  <dl class="space-y-4">
    {items.map((item) => (
      <div class="rounded-xl border border-[#1e293b] bg-[#0d1424] overflow-hidden">
        <dt>
          <button
            class="w-full text-left px-5 py-4 font-semibold text-[#f1f5f9] flex items-center justify-between gap-4 faq-toggle"
            aria-expanded="false"
          >
            <span>{item.q}</span>
            <svg class="w-4 h-4 shrink-0 text-[#0891b2] faq-icon transition-transform duration-200" viewBox="0 0 16 16" fill="currentColor">
              <path d="M8 4a.5.5 0 0 1 .5.5v3h3a.5.5 0 0 1 0 1h-3v3a.5.5 0 0 1-1 0v-3h-3a.5.5 0 0 1 0-1h3v-3A.5.5 0 0 1 8 4z"/>
            </svg>
          </button>
        </dt>
        <dd class="faq-answer hidden px-5 pb-4 text-[#94a3b8] leading-relaxed text-sm">
          {item.a}
        </dd>
      </div>
    ))}
  </dl>
</section>

<script>
  document.querySelectorAll('.faq-toggle').forEach((btn) => {
    btn.addEventListener('click', () => {
      const dd = btn.closest('div')?.querySelector('.faq-answer');
      const icon = btn.querySelector('.faq-icon');
      const expanded = btn.getAttribute('aria-expanded') === 'true';
      btn.setAttribute('aria-expanded', String(!expanded));
      dd?.classList.toggle('hidden');
      if (icon) icon.style.transform = expanded ? 'rotate(0deg)' : 'rotate(45deg)';
    });
  });
</script>
