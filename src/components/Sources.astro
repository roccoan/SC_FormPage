---
interface SourceItem {
  author: string;
  title: string;
  year: number;
  url: string;
}
interface Props {
  items: SourceItem[];
}
const { items } = Astro.props;
---

<div class="my-10 border-t border-[#1e293b] pt-6">
  <h3 class="text-xs font-bold text-[#64748b] uppercase tracking-widest mb-3">Sources</h3>
  <ol class="space-y-1">
    {items.map((s) => (
      <li class="text-xs text-[#94a3b8]">
        {s.author}. <a href={s.url} target="_blank" rel="noopener noreferrer" class="text-[#0891b2] hover:text-[#06b6d4] underline underline-offset-2">{s.title}</a>. {s.year}.
      </li>
    ))}
  </ol>
</div>
