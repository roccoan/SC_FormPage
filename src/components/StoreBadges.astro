---
interface Props {
  size?: 'sm' | 'md' | 'lg';
  class?: string;
}
const { size = 'md', class: className = '' } = Astro.props;
const APP_STORE_URL = import.meta.env.PUBLIC_APP_STORE_URL ?? '#coming-soon';
const PLAY_STORE_URL = import.meta.env.PUBLIC_PLAY_STORE_URL ?? '#coming-soon';
const isComingSoon = !import.meta.env.PUBLIC_APP_STORE_URL;

const px: Record<string, string> = { sm: 'px-3 py-2', md: 'px-4 py-2.5', lg: 'px-5 py-3' };
const iconSize: Record<string, string> = { sm: 'w-4 h-4', md: 'w-5 h-5', lg: 'w-6 h-6' };
const textSm: Record<string, string> = { sm: 'text-[9px]', md: 'text-[10px]', lg: 'text-xs' };
const textLg: Record<string, string> = { sm: 'text-sm', md: 'text-base', lg: 'text-lg' };
const p = px[size];
const ic = iconSize[size];
const ts = textSm[size];
const tl = textLg[size];
---

<div class={`flex flex-wrap items-center gap-3 ${className}`}>
  <!-- App Store badge -->
  <a
    href={APP_STORE_URL}
    class={`relative inline-flex items-center gap-2.5 ${p} bg-black border border-white/20 rounded-xl hover:bg-white/10 transition-colors`}
    aria-label="Download on the App Store"
  >
    <svg class={ic} viewBox="0 0 24 24" fill="white" xmlns="http://www.w3.org/2000/svg">
      <path d="M18.71 19.5c-.83 1.24-1.71 2.45-3.05 2.47-1.34.03-1.77-.79-3.29-.79-1.53 0-2 .77-3.27.82-1.31.05-2.3-1.32-3.14-2.53C4.25 17 2.94 12.45 4.7 9.39c.87-1.52 2.43-2.48 4.12-2.51 1.28-.02 2.5.87 3.29.87.78 0 2.26-1.07 3.8-.91.65.03 2.47.26 3.64 1.98-.09.06-2.17 1.28-2.15 3.81.03 3.02 2.65 4.03 2.68 4.04-.03.07-.42 1.44-1.38 2.83M13 3.5c.73-.83 1.94-1.46 2.94-1.5.13 1.17-.34 2.35-1.04 3.19-.69.85-1.83 1.51-2.95 1.42-.15-1.15.41-2.35 1.05-3.11z"/>
    </svg>
    <div>
      <div class={`${ts} text-white/60 leading-none`}>Download on the</div>
      <div class={`${tl} text-white font-semibold leading-tight`}>App Store</div>
    </div>
    {isComingSoon && (
      <span class="absolute -top-2 -right-2 bg-[#0891b2] text-white text-[10px] font-bold px-1.5 py-0.5 rounded-full">
        Soon
      </span>
    )}
  </a>

  <!-- Google Play badge -->
  <a
    href={PLAY_STORE_URL}
    class={`relative inline-flex items-center gap-2.5 ${p} bg-black border border-white/20 rounded-xl hover:bg-white/10 transition-colors`}
    aria-label="Get it on Google Play"
  >
    <svg class={ic} viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg">
      <path d="M3.18 23.76c.3.17.64.22.99.14l13.23-7.63-2.9-2.9-11.32 10.39z" fill="#EA4335"/>
      <path d="M22.46 10.48L19.2 8.6l-3.24 3.24 3.24 3.24 3.29-1.9c.94-.54.94-2.16-.03-2.7z" fill="#FBBC04"/>
      <path d="M3.18.24C2.83.33 2.5.58 2.3.97L13.63 12.3l2.9-2.9L3.18.24z" fill="#4285F4"/>
      <path d="M2.3.97C2.11 1.35 2 1.8 2 2.28v19.44c0 .48.1.93.3 1.31l.06.05 10.89-10.89v-.25L2.36.92l-.06.05z" fill="#34A853"/>
    </svg>
    <div>
      <div class={`${ts} text-white/60 leading-none`}>Get it on</div>
      <div class={`${tl} text-white font-semibold leading-tight`}>Google Play</div>
    </div>
    {isComingSoon && (
      <span class="absolute -top-2 -right-2 bg-[#0891b2] text-white text-[10px] font-bold px-1.5 py-0.5 rounded-full">
        Soon
      </span>
    )}
  </a>
</div>
