---
import StoreBadges from './StoreBadges.astro';

interface Props {
  title?: string;
  subtitle?: string;
}
const {
  title = 'Start tracking your health checks today',
  subtitle = 'Free for iOS and Android. Your data stays on your phone.',
} = Astro.props;
---

<div class="rounded-2xl bg-gradient-to-r from-[#0891b2]/20 to-[#06b6d4]/10 border border-[#0891b2]/30 p-8 text-center">
  <h2 class="text-xl font-bold text-[#f1f5f9] mb-2">{title}</h2>
  <p class="text-[#94a3b8] text-sm mb-6">{subtitle}</p>
  <div class="flex justify-center mb-4">
    <StoreBadges size="md" />
  </div>
  <p class="text-[#64748b] text-xs">Always consult your doctor for personal medical decisions.</p>
</div>
