---
const slides = [
  {
    image: '/images/2.png',
    caption: "You know you should probably get that blood test done. But between work, family, and everything else — it just keeps getting pushed back. Screening Clearing shows you exactly what's overdue, so nothing disappears into the mental pile.",
  },
  {
    image: '/images/1.png',
    caption: "A simple score. Not to judge — just to show you where things stand. Most people are surprised to see how many check-ups quietly drift past due. Now you can see the full picture at once.",
  },
  {
    image: '/images/3.png',
    caption: "When you're ready to act, the app gets out of your way. Log it as done, or note that you've got a plan. Either way, you're moving forward — and the app remembers it so you don't have to.",
  },
  {
    image: '/images/4.png',
    caption: "Every check-up you log becomes part of your personal health timeline. No more trying to remember when you last had a colonoscopy, or whether that eye exam was two years ago or three.",
  },
  {
    image: '/images/5.png',
    caption: "Your health history is personal. The app doesn't send anything anywhere — no account, no cloud, no server. It lives on your phone and nowhere else.",
  },
];
---

<section class="py-16 border-t border-[#1e293b] overflow-hidden">
  <div class="max-w-6xl mx-auto px-4">
    <h2 class="text-2xl md:text-3xl font-black text-[#f1f5f9] mb-2 text-center">See how it works</h2>
    <p class="text-[#94a3b8] text-center mb-10 max-w-xl mx-auto">Five screens. That's how simple staying on top of your health can be.</p>

    <div class="relative" id="showcase">
      <!-- Slides -->
      <div class="flex items-center gap-8 md:gap-16">

        <!-- Phone frame -->
        <div class="relative mx-auto w-[220px] md:w-[260px] shrink-0">
          <!-- Outer frame -->
          <div class="relative rounded-[2.5rem] bg-[#1a1a1a] shadow-2xl shadow-black/60 border border-white/10 overflow-hidden" style="padding: 10px;">
            <div class="rounded-[2rem] overflow-hidden bg-black relative" style="aspect-ratio: 9/19.5;">
              <!-- Screenshot -->
              {slides.map((slide, i) => (
                <img
                  src={slide.image}
                  alt={slide.caption.slice(0, 80)}
                  class="absolute inset-0 w-full h-full object-cover transition-opacity duration-500"
                  style={`opacity: ${i === 0 ? '1' : '0'}; z-index: ${i === 0 ? '1' : '0'};`}
                  data-slide={i}
                  width="390"
                  height="844"
                  loading={i === 0 ? 'eager' : 'lazy'}
                />
              ))}
            </div>
          </div>
          <!-- Glow -->
          <div class="absolute inset-0 rounded-[2.5rem] bg-[#0891b2]/10 blur-2xl -z-10 scale-110"></div>
        </div>

        <!-- Caption area -->
        <div class="flex-1 hidden md:block">
          <div class="relative min-h-[120px]">
            {slides.map((slide, i) => (
              <p
                class="absolute top-0 left-0 text-[#cbd5e1] text-lg leading-relaxed transition-all duration-500"
                style={`opacity: ${i === 0 ? '1' : '0'}; transform: translateY(${i === 0 ? '0' : '12px'})`}
                data-caption={i}
              >
                {slide.caption}
              </p>
            ))}
          </div>
        </div>
      </div>

      <!-- Caption mobile -->
      <div class="md:hidden mt-6 min-h-[100px] relative px-2">
        {slides.map((slide, i) => (
          <p
            class="absolute top-0 left-2 right-2 text-[#94a3b8] text-sm leading-relaxed transition-all duration-500 text-center"
            style={`opacity: ${i === 0 ? '1' : '0'}; transform: translateY(${i === 0 ? '0' : '8px'})`}
            data-caption-mobile={i}
          >
            {slide.caption}
          </p>
        ))}
      </div>

      <!-- Dots -->
      <div class="flex justify-center gap-2 mt-10">
        {slides.map((_, i) => (
          <button
            class="w-2.5 h-2.5 rounded-full transition-all duration-300 focus:outline-none"
            style={`background-color: ${i === 0 ? '#0891b2' : '#1e293b'}; transform: scale(${i === 0 ? '1.2' : '1'})`}
            data-dot={i}
            aria-label={`View screen ${i + 1}`}
          />
        ))}
      </div>

      <!-- Prev / Next arrows -->
      <button
        id="prev-btn"
        class="absolute left-0 top-1/2 -translate-y-1/2 -translate-x-2 md:-translate-x-6 w-9 h-9 rounded-full bg-[#0d1424] border border-[#1e293b] hover:border-[#0891b2] text-[#94a3b8] hover:text-[#f1f5f9] flex items-center justify-center transition-colors"
        aria-label="Previous"
      >
        <svg width="16" height="16" viewBox="0 0 16 16" fill="currentColor"><path d="M10.354 3.646a.5.5 0 0 1 0 .708L6.707 8l3.647 3.646a.5.5 0 0 1-.708.708l-4-4a.5.5 0 0 1 0-.708l4-4a.5.5 0 0 1 .708 0z"/></svg>
      </button>
      <button
        id="next-btn"
        class="absolute right-0 top-1/2 -translate-y-1/2 translate-x-2 md:translate-x-6 w-9 h-9 rounded-full bg-[#0d1424] border border-[#1e293b] hover:border-[#0891b2] text-[#94a3b8] hover:text-[#f1f5f9] flex items-center justify-center transition-colors"
        aria-label="Next"
      >
        <svg width="16" height="16" viewBox="0 0 16 16" fill="currentColor"><path d="M5.646 3.646a.5.5 0 0 0 0 .708L9.293 8 5.646 11.646a.5.5 0 0 0 .708.708l4-4a.5.5 0 0 0 0-.708l-4-4a.5.5 0 0 0-.708 0z"/></svg>
      </button>
    </div>
  </div>
</section>

<script>
  const total = 5;
  let current = 0;

  function goTo(index: number) {
    current = (index + total) % total;

    document.querySelectorAll('[data-slide]').forEach((el) => {
      const i = parseInt((el as HTMLElement).dataset.slide ?? '0');
      (el as HTMLElement).style.opacity = i === current ? '1' : '0';
      (el as HTMLElement).style.zIndex = i === current ? '1' : '0';
    });

    document.querySelectorAll('[data-caption]').forEach((el) => {
      const i = parseInt((el as HTMLElement).dataset.caption ?? '0');
      (el as HTMLElement).style.opacity = i === current ? '1' : '0';
      (el as HTMLElement).style.transform = i === current ? 'translateY(0)' : 'translateY(12px)';
    });

    document.querySelectorAll('[data-caption-mobile]').forEach((el) => {
      const i = parseInt((el as HTMLElement).dataset.captionMobile ?? '0');
      (el as HTMLElement).style.opacity = i === current ? '1' : '0';
      (el as HTMLElement).style.transform = i === current ? 'translateY(0)' : 'translateY(8px)';
    });

    document.querySelectorAll('[data-dot]').forEach((el) => {
      const i = parseInt((el as HTMLElement).dataset.dot ?? '0');
      (el as HTMLElement).style.backgroundColor = i === current ? '#0891b2' : '#1e293b';
      (el as HTMLElement).style.transform = i === current ? 'scale(1.2)' : 'scale(1)';
    });
  }

  document.getElementById('prev-btn')?.addEventListener('click', () => goTo(current - 1));
  document.getElementById('next-btn')?.addEventListener('click', () => goTo(current + 1));

  document.querySelectorAll('[data-dot]').forEach((btn) => {
    btn.addEventListener('click', () => goTo(parseInt((btn as HTMLElement).dataset.dot ?? '0')));
  });

  document.getElementById('showcase')?.addEventListener('keydown', (e) => {
    if ((e as KeyboardEvent).key === 'ArrowLeft') goTo(current - 1);
    if ((e as KeyboardEvent).key === 'ArrowRight') goTo(current + 1);
  });
</script>
