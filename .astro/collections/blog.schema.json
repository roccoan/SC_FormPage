{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "title": {
      "type": "string"
    },
    "description": {
      "type": "string"
    },
    "date": {
      "type": "string",
      "format": "date-time"
    },
    "lastReviewed": {
      "type": "string",
      "format": "date-time"
    },
    "author": {
      "default": "Screening Clearing Editorial",
      "type": "string"
    },
    "image": {
      "type": "string"
    },
    "imageAlt": {
      "type": "string"
    },
    "tags": {
      "default": [],
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "keywords": {
      "default": [],
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "type": {
      "type": "string",
      "enum": [
        "feature",
        "screening",
        "science"
      ]
    },
    "slug": {
      "type": "string"
    },
    "readingTime": {
      "type": "string"
    },
    "disclaimer": {
      "default": false,
      "type": "boolean"
    },
    "speakable": {
      "default": false,
      "type": "boolean"
    },
    "faqs": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "q": {
            "type": "string"
          },
          "a": {
            "type": "string"
          }
        },
        "required": [
          "q",
          "a"
        ]
      }
    },
    "$schema": {
      "type": "string"
    }
  },
  "required": [
    "title",
    "description",
    "date",
    "type"
  ]
}